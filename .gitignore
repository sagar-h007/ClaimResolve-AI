# ==========================================
# Git Ignore — ClaimResolve AI
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit credentials!)
.env
*.env
!.env.example
backend/.env
frontend/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend dependencies
node_modules/
dist/
dist-ssr/
*.local
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
claimresolve_local.db
uploads/
backend/uploads/

# Operating System & IDE metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker / Build artifacts
*.tar

