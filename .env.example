# ==============================================================================
# ClaimResolve AI — Environment & Deployment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to "production" when deploying to a public/cloud server.
ENVIRONMENT=production
PROJECT_NAME="ClaimResolve AI"
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# CRITICAL FOR PRODUCTION: Generate a unique 256-bit secret key.
# In bash/zsh, run: openssl rand -hex 32
SECRET_KEY=replace_with_your_own_generated_32_byte_secret_key_hex
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL with pgvector extension (pgvector/pgvector:pg16)
# Standard format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
#
# Docker Compose default:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/claimresolve_ai
#
# Managed cloud DB example (AWS RDS, Supabase, Neon, Railway):
# DATABASE_URL=postgresql+asyncpg://postgres:YourPass@db.xxxxxx.supabase.co:5432/postgres
#
# Standalone Local SQLite Fallback (No Postgres instance needed):
# DATABASE_URL=sqlite+aiosqlite:///./claimresolve_local.db

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Select your AI provider: "openai", "anthropic", or "mock"
#
# OPTION A: OpenAI (Recommended for full end-to-end LLM + RAG Embeddings)
# Only 1 key needed (covers both chat completion and text embeddings)!
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OPTION B: Anthropic Claude (For Claude 3.5 Sonnet clinical reasoning)
# LLM_PROVIDER=anthropic
# EMBEDDING_PROVIDER=mock # or openai if you want OpenAI embeddings with Claude reasoning
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OPTION C: High-Fidelity Local Mock (Zero external API keys required!)
# Deterministic clinical reasoning with full 1536-dimensional semantic embeddings.
# Ideal for staging, air-gapped deployments, CI/CD testing, and evaluation.
# LLM_PROVIDER=mock
# EMBEDDING_PROVIDER=mock

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB max document size

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND DOMAINS
# ------------------------------------------------------------------------------
# List of authorized frontend origins allowed to communicate with backend API.
# In production, specify your production domain(s):
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-domain.com"]

# ------------------------------------------------------------------------------
# 7. FRONTEND ENVIRONMENT (When building frontend separately)
# ------------------------------------------------------------------------------
# If deploying frontend to Vercel/Netlify and backend to Railway/Render:
# VITE_API_URL=https://api.your-domain.com
